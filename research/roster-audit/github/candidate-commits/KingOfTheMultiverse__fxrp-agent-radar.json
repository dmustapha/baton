TheMultiverse/repos","events_url":"https://api.github.com/users/KingOfTheMultiverse/events{/privacy}","received_events_url":"https://api.github.com/users/KingOfTheMultiverse/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"KingOfTheMultiverse","id":251525216,"node_id":"U_kgDODv34YA","avatar_url":"https://avatars.githubusercontent.com/u/251525216?v=4","gravatar_id":"","url":"https://api.github.com/users/KingOfTheMultiverse","html_url":"https://github.com/KingOfTheMultiverse","followers_url":"https://api.github.com/users/KingOfTheMultiverse/followers","following_url":"https://api.github.com/users/KingOfTheMultiverse/following{/other_user}","gists_url":"https://api.github.com/users/KingOfTheMultiverse/gists{/gist_id}","starred_url":"https://api.github.com/users/KingOfTheMultiverse/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KingOfTheMultiverse/subscriptions","organizations_url":"https://api.github.com/users/KingOfTheMultiverse/orgs","repos_url":"https://api.github.com/users/KingOfTheMultiverse/repos","events_url":"https://api.github.com/users/KingOfTheMultiverse/events{/privacy}","received_events_url":"https://api.github.com/users/KingOfTheMultiverse/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"4d1e069781e3354ea8fdd397127f3d5a6718245e","url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/4d1e069781e3354ea8fdd397127f3d5a6718245e","html_url":"https://github.com/KingOfTheMultiverse/fxrp-agent-radar/commit/4d1e069781e3354ea8fdd397127f3d5a6718245e"}]},{"sha":"4d1e069781e3354ea8fdd397127f3d5a6718245e","node_id":"C_kwDOTmseGdoAKDRkMWUwNjk3ODFlMzM1NGVhOGZkZDM5NzEyN2YzZDVhNjcxODI0NWU","commit":{"author":{"name":"KingOfTheMultiverse","email":"251525216+KingOfTheMultiverse@users.noreply.github.com","date":"2026-07-29T03:37:33Z"},"committer":{"name":"KingOfTheMultiverse","email":"251525216+KingOfTheMultiverse@users.noreply.github.com","date":"2026-07-29T03:37:33Z"},"message":"fix: honour maxRedeemedTickets, the protocol's per-transaction ticket cap\n\nFAssets caps how many redemption tickets a single redeem() consumes, to bound\ngas — 20 on Coston2, read from getSettings() rather than assumed. Without it the\npreview overstated what one transaction can actually fill.\n\nA shortfall now distinguishes two different situations: the ticket cap was hit\n(recoverable, redeem again for the rest) versus the queue is genuinely too\nshallow (not recoverable). Those look identical in the numbers alone and mean\nopposite things to a user.\n\nAlso corrects the module docstring, which still described picking an agent to\n'mint or redeem through'.","tree":{"sha":"aafffb37b8643711eb8971e70a5e54c0cfbd35f9","url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/git/trees/aafffb37b8643711eb8971e70a5e54c0cfbd35f9"},"url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/git/commits/4d1e069781e3354ea8fdd397127f3d5a6718245e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/4d1e069781e3354ea8fdd397127f3d5a6718245e","html_url":"https://github.com/KingOfTheMultiverse/fxrp-agent-radar/commit/4d1e069781e3354ea8fdd397127f3d5a6718245e","comments_url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/4d1e069781e3354ea8fdd397127f3d5a6718245e/comments","author":{"login":"KingOfTheMultiverse","id":251525216,"node_id":"U_kgDODv34YA","avatar_url":"https://avatars.githubusercontent.com/u/251525216?v=4","gravatar_id":"","url":"https://api.github.com/users/KingOfTheMultiverse","html_url":"https://github.com/KingOfTheMultiverse","followers_url":"https://api.github.com/users/KingOfTheMultiverse/followers","following_url":"https://api.github.com/users/KingOfTheMultiverse/following{/other_user}","gists_url":"https://api.github.com/users/KingOfTheMultiverse/gists{/gist_id}","starred_url":"https://api.github.com/users/KingOfTheMultiverse/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KingOfTheMultiverse/subscriptions","organizations_url":"https://api.github.com/users/KingOfTheMultiverse/orgs","repos_url":"https://api.github.com/users/KingOfTheMultiverse/repos","events_url":"https://api.github.com/users/KingOfTheMultiverse/events{/privacy}","received_events_url":"https://api.github.com/users/KingOfTheMultiverse/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"KingOfTheMultiverse","id":251525216,"node_id":"U_kgDODv34YA","avatar_url":"https://avatars.githubusercontent.com/u/251525216?v=4","gravatar_id":"","url":"https://api.github.com/users/KingOfTheMultiverse","html_url":"https://github.com/KingOfTheMultiverse","followers_url":"https://api.github.com/users/KingOfTheMultiverse/followers","following_url":"https://api.github.com/users/KingOfTheMultiverse/following{/other_user}","gists_url":"https://api.github.com/users/KingOfTheMultiverse/gists{/gist_id}","starred_url":"https://api.github.com/users/KingOfTheMultiverse/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KingOfTheMultiverse/subscriptions","organizations_url":"https://api.github.com/users/KingOfTheMultiverse/orgs","repos_url":"https://api.github.com/users/KingOfTheMultiverse/repos","events_url":"https://api.github.com/users/KingOfTheMultiverse/events{/privacy}","received_events_url":"https://api.github.com/users/KingOfTheMultiverse/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"66ce162706eeb0c2b1209de1e5bcebce7f29be47","url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/66ce162706eeb0c2b1209de1e5bcebce7f29be47","html_url":"https://github.com/KingOfTheMultiverse/fxrp-agent-radar/commit/66ce162706eeb0c2b1209de1e5bcebce7f29be47"}]},{"sha":"66ce162706eeb0c2b1209de1e5bcebce7f29be47","node_id":"C_kwDOTmseGdoAKDY2Y2UxNjI3MDZlZWIwYzJiMTIwOWRlMWU1YmNlYmNlN2YyOWJlNDc","commit":{"author":{"name":"KingOfTheMultiverse","email":"251525216+KingOfTheMultiverse@users.noreply.github.com","date":"2026-07-29T03:34:58Z"},"committer":{"name":"KingOfTheMultiverse","email":"251525216+KingOfTheMultiverse@users.noreply.github.com","date":"2026-07-29T03:34:58Z"},"message":"feat: redemption queue preview, and correct the mint/redeem distinction\n\nThe earlier framing said this picks an agent to 'mint or redeem through'. That is\nwrong for redemption: reserveCollateral() takes an agent address, but redeem()\ndoes not — tickets are consumed from a global FIFO queue, so a redeemer gets\nwhoever is at its head and cannot choose a safer counterparty.\n\nWhat a redeemer can do is look ahead. previewRedemption() walks the queue for a\ngiven size and reports which agents will fill it, in what proportion, and how\nmuch of the fill sits with agents whose underlying XRP does not cover what they\nowe — the share that will pay out in collateral rather than XRP.\n\nAdds loadRedemptionQueue(), previewRedemption(), a --redeem CLI flag, a\ndashboard panel, and tests covering FIFO ordering, at-risk share, and the\nshallow-queue shortfall case.","tree":{"sha":"c6c4fee98abd6a57fab911e615f14dd064ae70f7","url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/git/trees/c6c4fee98abd6a57fab911e615f14dd064ae70f7"},"url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/git/commits/66ce162706eeb0c2b1209de1e5bcebce7f29be47","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/66ce162706eeb0c2b1209de1e5bcebce7f29be47","html_url":"https://github.com/KingOfTheMultiverse/fxrp-agent-radar/commit/66ce162706eeb0c2b1209de1e5bcebce7f29be47","comments_url":"https://api.github.com/repos/K