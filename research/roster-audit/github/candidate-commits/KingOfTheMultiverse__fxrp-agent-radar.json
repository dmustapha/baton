,"starred_url":"https://api.github.com/users/KingOfTheMultiverse/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KingOfTheMultiverse/subscriptions","organizations_url":"https://api.github.com/users/KingOfTheMultiverse/orgs","repos_url":"https://api.github.com/users/KingOfTheMultiverse/repos","events_url":"https://api.github.com/users/KingOfTheMultiverse/events{/privacy}","received_events_url":"https://api.github.com/users/KingOfTheMultiverse/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"0052c9fc184605a66f6d7a93414044ce2027e279","url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/0052c9fc184605a66f6d7a93414044ce2027e279","html_url":"https://github.com/KingOfTheMultiverse/fxrp-agent-radar/commit/0052c9fc184605a66f6d7a93414044ce2027e279"}]},{"sha":"0052c9fc184605a66f6d7a93414044ce2027e279","node_id":"C_kwDOTmseGdoAKDAwNTJjOWZjMTg0NjA1YTY2ZjZkN2E5MzQxNDA0NGNlMjAyN2UyNzk","commit":{"author":{"name":"KingOfTheMultiverse","email":"251525216+KingOfTheMultiverse@users.noreply.github.com","date":"2026-07-29T03:20:58Z"},"committer":{"name":"KingOfTheMultiverse","email":"251525216+KingOfTheMultiverse@users.noreply.github.com","date":"2026-07-29T03:20:58Z"},"message":"feat: FXRP Agent Radar — risk-scored agent selection for Flare FAssets\n\nMinting or redeeming FXRP requires choosing a collateralised agent, but the\nAssetManager exposes 40 raw fields and no judgement. Two risks stay invisible:\n\n1. Liquidation proximity. Vault and pool collateral have different thresholds\n   (120% and 150%), so a single ratio means different things depending on which\n   collateral it describes.\n2. Redemption default. When an agent's underlying XRP no longer covers what it\n   owes, redemption pays collateral at 105% instead of XRP — a redeemer who\n   wanted XRP does not get XRP, and nothing surfaces this beforehand.\n\nReads live Coston2 state, resolves each agent's real thresholds, and produces a\n0-100 risk-adjusted score weighted 40/30/20/10 across collateral safety,\nbacking, capacity and fee. Agents outside NORMAL status score zero.\n\nIntegrates FAssets (AssetManagerFXRP), FTSOv2 for USD valuation, and the Flare\ncontract registry so no deployment address is hardcoded.\n\nIncludes a stress preview that replays the same scoring functions down a\ndegradation path, since every live testnet agent is over-collateralised and the\ndangerous end of the curve would otherwise be untestable.","tree":{"sha":"2eb1d2e56a1c0fd9fd59b5ee664517a5c0d3e13d","url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/git/trees/2eb1d2e56a1c0fd9fd59b5ee664517a5c0d3e13d"},"url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/git/commits/0052c9fc184605a66f6d7a93414044ce2027e279","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/0052c9fc184605a66f6d7a93414044ce2027e279","html_url":"https://github.com/KingOfTheMultiverse/fxrp-agent-radar/commit/0052c9fc184605a66f6d7a93414044ce2027e279","comments_url":"https://api.github.com/repos/KingOfTheMultiverse/fxrp-agent-radar/commits/0052c9fc184605a66f6d7a93414044ce2027e279/comments","author":{"login":"KingOfTheMultiverse","id":251525216,"node_id":"U_kgDODv34YA","avatar_url":"https://avatars.githubusercontent.com/u/251525216?v=4","gravatar_id":"","url":"https://api.github.com/users/KingOfTheMultiverse","html_url":"https://github.com/KingOfTheMultiverse","followers_url":"https://api.github.com/users/KingOfTheMultiverse/followers","following_url":"https://api.github.com/users/KingOfTheMultiverse/following{/other_user}","gists_url":"https://api.github.com/users/KingOfTheMultiverse/gists{/gist_id}","starred_url":"https://api.github.com/users/KingOfTheMultiverse/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/KingOfTheMultiv