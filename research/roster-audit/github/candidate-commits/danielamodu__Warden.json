I4MGEwODRiYTA5OTIzNDc4NWU3NTdiZTc4YzAzMzljMWUyMzJmZTY","commit":{"author":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-12T12:02:54Z"},"committer":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-12T12:02:54Z"},"message":"Add favicon set from W mark and wire into index.html head\n\nGenerate favicon.svg, favicon.ico (16/32/48 multi-res), and\napple-touch-icon.png (180x180) from the existing favicon-w.svg source,\nand add the corresponding <link> tags to app/index.html.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","tree":{"sha":"6723e7cd5a97c29dc8d48ecf03bfbafdc3552835","url":"https://api.github.com/repos/danielamodu/Warden/git/trees/6723e7cd5a97c29dc8d48ecf03bfbafdc3552835"},"url":"https://api.github.com/repos/danielamodu/Warden/git/commits/b80a084ba099234785e757be78c0339c1e232fe6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/danielamodu/Warden/commits/b80a084ba099234785e757be78c0339c1e232fe6","html_url":"https://github.com/danielamodu/Warden/commit/b80a084ba099234785e757be78c0339c1e232fe6","comments_url":"https://api.github.com/repos/danielamodu/Warden/commits/b80a084ba099234785e757be78c0339c1e232fe6/comments","author":{"login":"danielamodu","id":127061887,"node_id":"U_kgDOB5LPfw","avatar_url":"https://avatars.githubusercontent.com/u/127061887?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamodu","html_url":"https://github.com/danielamodu","followers_url":"https://api.github.com/users/danielamodu/followers","following_url":"https://api.github.com/users/danielamodu/following{/other_user}","gists_url":"https://api.github.com/users/danielamodu/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamodu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamodu/subscriptions","organizations_url":"https://api.github.com/users/danielamodu/orgs","repos_url":"https://api.github.com/users/danielamodu/repos","events_url":"https://api.github.com/users/danielamodu/events{/privacy}","received_events_url":"https://api.github.com/users/danielamodu/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"danielamodu","id":127061887,"node_id":"U_kgDOB5LPfw","avatar_url":"https://avatars.githubusercontent.com/u/127061887?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamodu","html_url":"https://github.com/danielamodu","followers_url":"https://api.github.com/users/danielamodu/followers","following_url":"https://api.github.com/users/danielamodu/following{/other_user}","gists_url":"https://api.github.com/users/danielamodu/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamodu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamodu/subscriptions","organizations_url":"https://api.github.com/users/danielamodu/orgs","repos_url":"https://api.github.com/users/danielamodu/repos","events_url":"https://api.github.com/users/danielamodu/events{/privacy}","received_events_url":"https://api.github.com/users/danielamodu/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"49e2dd8f133106867841e9f199c513b992a4076f","url":"https://api.github.com/repos/danielamodu/Warden/commits/49e2dd8f133106867841e9f199c513b992a4076f","html_url":"https://github.com/danielamodu/Warden/commit/49e2dd8f133106867841e9f199c513b992a4076f"}]},{"sha":"49e2dd8f133106867841e9f199c513b992a4076f","node_id":"C_kwDOT0qK59oAKDQ5ZTJkZDhmMTMzMTA2ODY3ODQxZTlmMTk5YzUxM2I5OTJhNDA3NmY","commit":{"author":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-12T11:28:14Z"},"committer":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-12T11:28:14Z"},"message":"Add Warden React app: Superdesign port + live Coston2/XRPL wiring\n\nFull frontend for the escrow platform, built from the approved Superdesign\npage set (landing, connect wallet, create escrow, dashboard, escrow detail,\ndispute flow, payout, proof panel) and wired end to end to real chain state\nrather than mock data:\n\n- Real EIP-6963 wallet connect (multi-provider detection, no XRPL wallet\n  names left over from the original design mockup).\n- Live eth_call reads against the deployed Phase 2 (WardenWeatherResolver)\n  and Phase 3 (WardenDisputeResolver) contracts on Coston2, live XRPL\n  testnet balance/payout polling, live Open-Meteo weather reads.\n- Real write paths: WardenEscrow.fund() for Create Escrow, and a from-\n  scratch TypeScript port of the ECIES scheme the Go tooling uses to\n  encrypt dispute evidence to the live TEE's public key -- verified\n  byte-for-byte against the actual go-ethereum/crypto/ecies implementation\n  (encrypt in TS, decrypt in Go, matched) before wiring it to\n  sendRuleOnEvidence().\n- IEscrowService interface with Mock/Real implementations, swappable via\n  VITE_USE_MOCK_DATA, so the page components never talk to chain/XRPL\n  directly.\n\nTwo flows are code-complete but not live-fired yet: Create Escrow (deployer\nwallet currently holds 0 FXRP) and Submit Evidence (TEE extension proxy\ntunnel is currently down) -- both fail on real, external preconditions\nrather than on anything in this code.","tree":{"sha":"2b4db2f7e6cb882ee387ecd2b300d5696438b2ac","url":"https://api.github.com/repos/danielamodu/Warden/git/trees/2b4db2f7e6cb882ee387ecd2b300d5696438b2ac"},"url":"https://api.github.com/repos/danielamodu/Warden/git/commits/49e2dd8f133106867841e9f199c513b992a4076f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/danielamodu/Warden/commits/49e2dd8f133106867841e9f199c513b992a4076f","html_url":"https://github.com/danielamodu/Warden/commit/49e2dd8f133106867841e9f199c513b992a4076f","comments_url":"https://api.github.com/repos/danielamodu/Warden/commits/49e2dd8f133106867841e9f199c513b992a4076f/comments","author":{"login":"danielamodu","id":127061887,"node_id":"U_kgDOB5LPfw","avatar_url":"https://avatars.githubusercontent.com/u/127061887?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamodu","html_url":"https://github.com/danielamodu","followers_url":"https://api.github.com/users/danielamodu/followers","following_url":"https://api.github.com/users/danielamodu/following{/other_user}","gists_url":"https://api.github.com/users/danielamodu/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamodu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamodu/subscriptions","organizations_url":"https://api.github.com/users/danielamodu/orgs","repos_url":"https://api.github.com/users/danielamodu/repos","events_url":"https://api.github.com/users/danielamodu/events{/privacy}","received_events_url":"https://api.github.com/users/danielamodu/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"danielamodu","id":127061887,"node_id":"U_kgDOB5LPfw","avatar_url":"https://avatars.githubusercontent.com/u/127061887?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamodu","html_url":"https://github.com/danielamodu","followers_url":"https://api.github.com/users/danielamodu/followers","following_url":"https://api.github.com/users/danielamodu/following{/other_user}","gists_url":"https://api.github.com/users/danielamodu/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamodu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamodu/subscriptions","organizations_url":"https://api.github.com/users/danielamodu/orgs","repos_url":"https://api.github.com/users/danielamodu/repos","events_url":"https://api.github.com/users/danielamodu/events{/privacy}","received_events_url":"https://api.github.com/users/danielamodu/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5a7fea83ed4d2171cf2986ab61f677ea30708f81","url":"https://api.github.com/repos/danielamodu/Warden/commits/5a7fea83ed4d2171cf2986ab61f677ea30708f81","html_url":"https://github.com/danielamodu/Warden/commit/5a7fea83ed4d2171cf2986ab61f677ea30708f81"}]},{"sha":"5a7fea83ed4d2171cf2986ab61f677ea30708f81","node_id":"C_kwDOT0qK59oAKDVhN2ZlYTgzZWQ0ZDIxNzFjZjI5ODZhYjYxZjY3N2VhMzA3MDhmODE","commit":{"author":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-11T21:50:23Z"},"committer":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-11T21:50:23Z"},"message":"Phase 3: resolve live infra issues, verify end to end on Coston2\n\nGetting the dispute path actually running live surfaced two real bugs beyond\nthe feature code itself:\n\n- The cloudflared quick tunnel died mid-phase and had to be restarted, which\n  mints a new hostname. Rebuilding extension-tee to pick up the new handler\n  also minted a brand-new teeId (Confidential Space keys are memory-only, so\n  every relaunch mints one) -- the old registered teeId was simply dead.\n  Fixed with a fresh full register-tee run for the new teeId, plus the\n  on-chain updateTeeMachineSettings fix from Task 2 for the URL itself.\n- The already-deployed InstructionSender contract predated\n  sendRuleOnEvidence, so calling it reverted (unmatched selector). Rather\n  than minting a whole new extension ID -- which would have cascaded into\n  redeploying WardenDisputeResolver and WardenEscrow, and re-funding the\n  escrow -- repointed the existing extension ID at a freshly deployed\n  InstructionSender via setExtensionContracts(), keeping the TEE\n  registration, resolver, and funded escrow all valid.\n\nWith both fixed, ran the real thing: two conflicting evidence sets through\nthe live TEE, a signed verdict (outcome=true), on-chain signature\nverification in WardenDisputeResolver.submitVerdict() succeeding against a\nreal TEE signature for the first time, and a real 9.95 XRP payout on XRPL\ntestnet. Full writeup with live artifacts and tx hashes in PHASE3.md.","tree":{"sha":"bfab925e745822e396949149d2dc12a3432f9a65","url":"https://api.github.com/repos/danielamodu/Warden/git/trees/bfab925e745822e396949149d2dc12a3432f9a65"},"url":"https://api.github.com/repos/danielamodu/Warden/git/commits/5a7fea83ed4d2171cf2986ab61f677ea30708f81","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/danielamodu/Warden/commits/5a7fea83ed4d2171cf2986ab61f677ea30708f81","html_url":"https://github.com/danielamodu/Warden/commit/5a7fea83ed4d2171cf2986ab61f677ea30708f81","comments_url":"https://api.github.com/repos/danielamodu/Warden/commits/5a7fea83ed4d2171cf2986ab61f677ea30708f81/comments","author":{"login":"danielamodu","id":127061887,"node_id":"U_kgDOB5LPfw","avatar_url":"https://avatars.githubusercontent.com/u/127061887?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamodu","html_url":"https://github.com/danielamodu","followers_url":"https://api.github.com/users/danielamodu/followers","following_url":"https://api.github.com/users/danielamodu/following{/other_user}","gists_url":"https://api.github.com/users/danielamodu/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamodu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamodu/subscriptions","organizations_url":"https://api.github.com/users/danielamodu/orgs","repos_url":"https://api.github.com/users/danielamodu/repos","events_url":"https://api.github.com/users/danielamodu/events{/privacy}","received_events_url":"https://api.github.com/users/danielamodu/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"danielamodu","id":127061887,"node_id":"U_kgDOB5LPfw","avatar_url":"https://avatars.githubusercontent.com/u/127061887?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamodu","html_url":"https://github.com/danielamodu","followers_url":"https://api.github.com/users/danielamodu/followers","following_url":"https://api.github.com/users/danielamodu/following{/other_user}","gists_url":"https://api.github.com/users/danielamodu/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamodu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamodu/subscriptions","organizations_url":"https://api.github.com/users/danielamodu/orgs","repos_url":"https://api.github.com/users/danielamodu/repos","events_url":"https://api.github.com/users/danielamodu/events{/privacy}","received_events_url":"https://api.github.com/users/danielamodu/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"b3be76e1715e67b610ce3882fd5adf47f63fe441","url":"https://api.github.com/repos/danielamodu/Warden/commits/b3be76e1715e67b610ce3882fd5adf47f63fe441","html_url":"https://github.com/danielamodu/Warden/commit/b3be76e1715e67b610ce3882fd5adf47f63fe441"}]},{"sha":"b3be76e1715e67b610ce3882fd5adf47f63fe441","node_id":"C_kwDOT0qK59oAKGIzYmU3NmUxNzE1ZTY3YjYxMGNlMzg4MmZkNWFkZjQ3ZjYzZmU0NDE","commit":{"author":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-11T21:17:28Z"},"committer":{"name":"£","email":"kenpachi.eth@outlook.com","date":"2026-08-11T21:17:28Z"},"message":"Phase 3: implement dispute path (WardenDisputeResolver, RULE_ON_EVIDENCE)\n\nAdds trustless on-chain TEE-signature verification for dispute arbitration,\nfollowing Phase 2's pattern: a vertical-specific resolver calls\nWardenEscrow.resolveAndRelease() as the single generic release hook, so\nWardenEscrow itself needs zero changes.\n\n- WardenDisputeResolver.submitVerdict() reconstructs tee-node's internal\n  signing scheme (ActionResult.Hash -> signing.Payload.Hash -> EIP-191) and\n  ecrecover()s it against the TEE's on-chain-registered public key, rather\n  than trusting the extension proxy's HTTP response.\n- New DISPUTE/RULE_ON_EVIDENCE operation on the fce-extension-scaffold: a\n  deterministic rules-engine handler (claimed timestamp inside vs. outside\n  an FDC-verified window), ABI-encoded response so the resolver can decode\n  it on-chain after verifying the signature.\n- dispute-demo CLI mirrors run-test's pattern: encrypts evidence client-side\n  (ECIES), sends the instruction, polls for the signed verdict.\n- Node.js scripts for the Warden side: mint FXRP, deploy escrow + resolver,\n  fund a disputed escrow, submit the verdict on-chain, monitor XRPL payout.","tree":{"sha":"7f494234debf04b92710da2b0c5ff3707e5c455e","url":"https://api.github.com/repos/danielamodu/Warden/git/trees/7f494234debf04b92710da2b0c5ff3707e5c455e"},"url":"https://api.github.com/repos/danielamodu/Warden/git/commits/b3be76e1715e67b610ce3882fd5adf47f63fe441","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/danielamodu/Warden/commits/b3be76e1715e67b610ce3882fd5adf47f63fe441","html_url":"https://github.com/danielamodu/Warden/commit/b3be76e1715e67b610ce3882fd5adf47f63fe441","comments_url":"https://api.github.com/repos/danielamodu/Warden/commits/b3be76e1715e67b610ce3882fd5adf47f63fe441/comments","author":{"login":"danielamodu","id":127061887,"node_id":"U_kgDOB5LPfw","avatar_url":"https://avatars.githubusercontent.com/u/127061887?v=4","gravatar_id":"","url":"https://api.github.com/users/danielamodu","html_url":"https://github.com/danielamodu","followers_url":"https://api.github.com/users/danielamodu/followers","following_url":"https://api.github.com/users/danielamodu/following{/other_user}","gists_url":"https://api.github.com/users/danielamodu/gists{/gist_id}","starred_url":"https://api.github.com/users/danielamodu/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/danielamodu/subscriptions","organizations_url":"https://api.github.com/users/danielamodu/orgs","repos_url":"https://api.github.com/users/danielamodu/repos","events_url":"https