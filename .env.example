# Baton — credentials & config manifest (placeholders only; never commit real secrets)
# Conductor Checkpoint 3 reads this before dispatching build.

# --- Coston2 / Flare (no key needed; operator pays gas) ---
# Coston2 RPC — obtain from: brief §6 (public, no auth)
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
# XRP/USD FTSOv2 feed id — verify in build vs getFeedById
FTSO_FEED_XRP_USD=0x015852502f55534400000000000000000000000000

# --- XRPL Testnet ---
# XRPL testnet WSS — obtain from: public XRPL testnet
XRPL_WSS=wss://s.altnet.rippletest.net:51233
# Operator provider wallet — from getXrplProviderWallets() (verified live)
PROVIDER_XRPL_WALLET=rEyj8nsHLdgt79KJWzXR5BgF7ZbaohbXwq
# Demo XRPL testnet seed — obtain from: https://faucet.altnet.rippletest.net (browser-side only for real users; server uses it only in scripts/task0-e2e.ts)
DEMO_XRPL_SEED=sEd_REPLACE_WITH_FUNDED_TESTNET_SEED

# --- Reference CLI (encoding authority) ---
# Cloned path — obtain from: git clone flare-foundation/smart-accounts-cli (Task 0.1)
SMART_ACCOUNTS_CLI_DIR=../smart-accounts-cli
# Python interpreter
CLI_PYTHON=python3
# CLI entry/module — PIN in Task 0.1 from --help / pyproject [project.scripts]
CLI_ENTRY=-m smart_accounts_cli

# --- Depth ladder (set by Gate-1, Task 1.3) ---
# depth-8 = real FXRP direct-mint via agent; depth-7 = faucet FTestXRP. Both keep atomic multi-vault.
BATON_DEPTH=depth-7
